# The speech node as a systemd user service, an example: it runs `bin/ringback-speech serve`
# in ~/ringback-speech with env.sh's environment, starts it again if it fails, and its log goes
# to the journal. For another install directory, change WorkingDirectory. To use it:
#   cp speech/ringback-speech.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ringback-speech
#   loginctl enable-linger      # so it runs from boot, not only while you're logged in
#   journalctl --user -u ringback-speech -f
[Unit]
Description=ringback speech node

[Service]
WorkingDirectory=%h/ringback-speech
ExecStart=/bin/sh -c '. ./env.sh && exec bin/ringback-speech serve'
Restart=on-failure
RestartSec=5
# The stop signal goes to serve alone, which stops its worker (a model-loading process).
KillMode=mixed

[Install]
WantedBy=default.target
